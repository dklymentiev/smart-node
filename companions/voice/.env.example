# Smart Node voice adapter -- environment
# Copy to .env and fill in. .env is gitignored.

# Gemini Native Audio API key (realtime voice)
GOOGLE_API_KEY=your_google_api_key

# Node voice identity (shown to the user as the assistant name)
ASSISTANT_NAME=assistant

# Persistence -- identity, sessions, message logs (NOT memory)
DB_PATH=/data/voice.db

# Node memory companion (Mesh) -- per-user memory store.
# On a node this is the smart-node-mesh container on the smart-node
# docker network; the companion runs AUTH_REQUIRED=false so MESH_API_KEY
# stays empty there.
MESH_API_URL=http://smart-node-mesh:8000
MESH_WORKSPACE=voice
MESH_API_KEY=

# Access control
VOICE_ADMIN_TOKEN=change_me
VOICE_ACCESS_PHRASE=your_access_phrase
VOICE_MAX_SESSIONS_HOUR=20

# v1 = answer-now only. Capability forwarding disabled (no Telegram bridge).
VOICE_FORWARD_ENABLED=0
