# Copy to /etc/smart-node/admin-runner.env and fill in. All required vars fail loud if unset.
# Authorization is per-op via sn_config.role_permissions. The former
# SN_ADMIN_OWNER_ROLES is no longer consulted and the var is kept read-only
# for backward-compatible env parsing on upgrades.
SN_ADMIN_DB_USER=sn-admin
SN_ADMIN_DB_NAME=smartnode
# SN_TRUSTED_CIDRS=10.0.0.0/24
