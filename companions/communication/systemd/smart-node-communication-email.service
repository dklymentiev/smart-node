[Unit]
Description=Smart Node communication -- email adapter (poll pass)
After=network-online.target postgresql@16-smartnode.service
Wants=network-online.target

[Service]
Type=oneshot
User=smart-node-communication
Group=smart-node
WorkingDirectory=/opt/smart-node/communication
EnvironmentFile=/opt/smart-node/communication/.env
ExecStart=/opt/smart-node/communication/venv/bin/python -m adapters.email.adapter
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=true
ProtectHome=true
ReadWritePaths=/opt/smart-node/communication /var/log/smart-node/communication
StandardOutput=append:/var/log/smart-node/communication/adapters.email.adapter.log
StandardError=append:/var/log/smart-node/communication/adapters.email.adapter.log
