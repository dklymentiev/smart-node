# AI Gateway Configuration
# Copy to .env and adjust values

# ============== Server ==============
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000

# ============== Security ==============
# API key for authentication (optional, if unset only IP whitelist is used)
# GATEWAY_API_KEY=your-secret-key-here

# Comma-separated IP prefixes allowed to access the API
ALLOWED_IPS=127.0.0.1

# Comma-separated trusted proxy IPs (for X-Real-IP / CF-Connecting-IP headers)
TRUSTED_PROXIES=127.0.0.1

# ============== CLI Provider ==============
# Path to Claude CLI binary
CLI_PATH=claude

# Allow Claude CLI to skip permission prompts (DANGEROUS - only for trusted environments)
SKIP_PERMISSIONS=false

# Max concurrent CLI sessions
CLI_MAX_SESSIONS=10

# Session idle timeout in seconds
CLI_SESSION_TIMEOUT=3600

# ============== Cloud Providers (optional) ==============
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...

# ============== Logging ==============
# Log directory
LOGS_DIR=./logs

# Log full prompt/response content (default: false for privacy)
LOG_CONTENT=false

# ============== Features ==============
# Enable /docs and /redoc endpoints
ENABLE_DOCS=false

# Enable /api/v1/usage endpoint (exposes local Claude stats)
ENABLE_USAGE_ENDPOINT=false
