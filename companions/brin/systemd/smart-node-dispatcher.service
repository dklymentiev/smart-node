[Unit]
Description=Smart Node dispatcher companion (brin -- realtime trigger)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smart-node-dispatcher
Group=smart-node
WorkingDirectory=/opt/smart-node/dispatcher
EnvironmentFile=/opt/smart-node/dispatcher/.env
ExecStart=/opt/smart-node/dispatcher/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8101
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=true
ProtectHome=true
ReadWritePaths=/opt/smart-node/dispatcher /var/log/smart-node/dispatcher
StandardOutput=append:/var/log/smart-node/dispatcher/service.log
StandardError=append:/var/log/smart-node/dispatcher/service.log

[Install]
WantedBy=multi-user.target
