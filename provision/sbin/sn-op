#!/bin/bash
#
# sn-op -- validated sysadmin operational wrapper.
#
# Root-owned, root-executed via sudoers. The one binary agent-sysadmin is
# permitted to invoke (Cmnd_Alias SN_OP in /etc/sudoers.d/agent-max).
#
# Every argument is validated against a typed regex before any canonicalisation.
# After validation, exec the real binary with quoted -- args. Never sh -c, never
# $*, never a variable number of trailing paths.
#
# Every invocation emits a row to sn_core.events with kind='sysadmin.op' via
# core-api on the /run/smart-node/api/core-api.sock. If core-api is unreachable
# (e.g. it is the very service being restarted), a NDJSON line is written to
# /var/log/sn-op-fallback.jsonl (0640 root:adm). FAIL-LOUD: if neither path
# accepts the "accepted" event, the wrapper refuses to proceed.
#
# Tier B verbs (service-stop, container-stop, rm) require --approval <task_id>
# where the task is in_progress with approved_at set (the owner approved it;
# only the owner can) within 300 seconds, argv matches, and no prior
# exec_ok|exec_error row consumed the approval. Any failed check refuses with a
# named error (SN_OP_APPROVAL_*).
#
# The argument and approval checks below define the accepted operations.
#
# unit-install / unit-enable (0.2.0): lets the sysadmin agent put a
# smart-node-*.service|timer into /etc/systemd/system. A unit file is code run
# as root, so the boundary is its CONTENT: unit-install is Tier B, binds the
# file by sha256 in argv, copies it once into a root-only directory, refuses a
# service without an agent-*/smart-node-* User= (or with a + / ! Exec prefix,
# PermissionsStartOnly=, AmbientCapabilities=), and never replaces a unit it did
# not install itself (marker line on the first line).
#
# run / verbs (0.3.0): a root-owned table, /etc/smart-node/sn-op-verbs.json,
# names the operations the sysadmin may run beyond the fixed verbs above, so a
# new one is a row in that file and not an edit of this script. The table is
# trusted only while root owns it and neither it nor its directory is writable
# by anyone else. A row gives a fixed argv prefix (an absolute path under
# /opt/smart-node or /usr/local/sbin, no symlinks, root-owned, not writable by
# others) and one regex per argument; every argument must match its regex in
# full, may not start with '-', and the count must be exact. Never a shell.
# A row with "tier": "B" needs --approval like the destructive verbs above.
#
# dropin-install (0.4.0): lets the sysadmin agent add a small systemd drop-in
# to an existing smart-node-* unit, for the case where a service needs one more
# directory it may write to. Tier B like unit-install: the source is bound by
# sha256, copied once into a root-only directory and checked there. The
# boundary is the CONTENT again, and it is an allowlist: a [Service] section with
# ReadWritePaths= (only under /var/lib/smart-node or /var/log/smart-node),
# ReadOnlyPaths=, InaccessiblePaths=, Restart= and RestartSec=. Everything else
# (User=, Exec*=, capabilities, Environment=, other sections) is refused. It
# never replaces a drop-in it did not install, and it does not restart anything:
# service-restart is its own verb.
#
# route-install (0.5.0): lets the sysadmin agent publish an INTERNAL route for a
# service it built: a Traefik file-provider file in /etc/smart-node/traefik/dynamic.
# Tier B, sha256-bound, copied once into a root-only directory and checked there by
# an allowlist: only http.routers and http.services; a router is one
# Host(`<name>.<internal domain>`) on websecure with tls {} and at least one of the
# access middlewares vpn-only@file / smart-node-auth@docker; a service is a
# loadBalancer to http://host.docker.internal:PORT or http://127.0.0.1:PORT with
# PORT >= 1024. Router and service names start with smart-node- and may not exist
# in, and the Host may not appear in, any other file of that directory. Files are
# 80-89-name.yml, carry our marker and are never written over unmarked ones. The internal
# domain is the node's own, one line in /etc/smart-node/sn-op-route-domain (root-owned, like
# the verb table); with no such file the verb refuses, it has no default to fall back on.
#
# ufw-allow-docker (0.6.0): lets the sysadmin agent open one port of an app it runs on the host
# to the node's own Docker network, which is where Traefik lives, and to nothing else. Tier B.
# One rule only: allow from the node's Docker subnet (SMART_NODE_DOCKER_SUBNET in routing.env,
# a private range) to a TCP port inside the range in /etc/smart-node/sn-op-app-ports (one line,
# LOW-HIGH, root-owned; no file, no verb). It cannot name another source, another protocol, a
# port outside the range or a port below 1024, and it never opens anything to the internet.
#
# Modes:
#   SNOP_DRY_RUN=1  Run all validation and approval checks, print the resolved
#                   argv to stdout as "would-exec: <argv>", skip event emit and
#                   the real exec. Exit 0 if validation passed, non-zero with a
#                   named error otherwise. For tests/permissions-sn-op.test.sh.

set -euo pipefail

readonly SN_OP_VERSION="0.6.0"
readonly SOCKET="/run/smart-node/api/core-api.sock"
readonly EVENTS_URL="http://localhost/api/events"
readonly PLANNER_TASK_URL="http://localhost/api/planner/api/v1/tasks"
readonly FALLBACK_LOG="/var/log/sn-op-fallback.jsonl"
readonly FRESHNESS_SECONDS=300
# Where unit-install writes. Only a dry run may point it elsewhere, so a test
# can stage fixtures without root; a real run always uses /etc/systemd/system.
UNIT_DIR="/etc/systemd/system"
if [[ "${SNOP_DRY_RUN:-0}" == "1" && -n "${SNOP_DRY_RUN_UNIT_DIR:-}" ]]; then
    UNIT_DIR="$SNOP_DRY_RUN_UNIT_DIR"
fi

# Where route-install writes, and where it reads the node's internal domain. Only a dry run
# may point either elsewhere.
TRAEFIK_DIR="/etc/smart-node/traefik/dynamic"
ROUTE_DOMAIN_FILE="/etc/smart-node/sn-op-route-domain"
if [[ "${SNOP_DRY_RUN:-0}" == "1" ]]; then
    [[ -n "${SNOP_DRY_RUN_TRAEFIK_DIR:-}" ]] && TRAEFIK_DIR="$SNOP_DRY_RUN_TRAEFIK_DIR"
    [[ -n "${SNOP_DRY_RUN_ROUTE_DOMAIN_FILE:-}" ]] && ROUTE_DOMAIN_FILE="$SNOP_DRY_RUN_ROUTE_DOMAIN_FILE"
fi

# Where ufw-allow-docker reads the node's Docker subnet and the port range it may open. Only a
# dry run may point either elsewhere.
ROUTING_ENV="/etc/smart-node/routing.env"
APP_PORTS_FILE="/etc/smart-node/sn-op-app-ports"
if [[ "${SNOP_DRY_RUN:-0}" == "1" ]]; then
    [[ -n "${SNOP_DRY_RUN_ROUTING_ENV:-}" ]] && ROUTING_ENV="$SNOP_DRY_RUN_ROUTING_ENV"
    [[ -n "${SNOP_DRY_RUN_APP_PORTS_FILE:-}" ]] && APP_PORTS_FILE="$SNOP_DRY_RUN_APP_PORTS_FILE"
fi

DRY_RUN="${SNOP_DRY_RUN:-0}"

# The table of operations. Only a dry run may point it at a fixture, so a test
# can stage one without root; a real run always reads the root-owned file.
VERB_TABLE="/etc/smart-node/sn-op-verbs.json"
if [[ "$DRY_RUN" == "1" && -n "${SNOP_DRY_RUN_VERB_TABLE:-}" ]]; then
    VERB_TABLE="$SNOP_DRY_RUN_VERB_TABLE"
fi
readonly RE_TABLE_VERB='^[a-z][a-z0-9-]{0,39}$'

# ---------- named errors ----------------------------------------------------

die_named() {
    local name="$1"
    local msg="${2:-}"
    printf '[sn-op] %s: %s\n' "$name" "$msg" >&2
    # Emit refuse event before exiting, unless we are already deep enough that
    # emission would cascade. Refuse-emit failures do not block the exit.
    _emit_refuse "$name" "$msg" || true
    exit 2
}

# ---------- argument regexes (verbatim from 7327) ---------------------------

readonly RE_GROUP='^grp-[a-z0-9-]+$'
readonly RE_USER='^(agent-[a-z0-9-]+|admin)$'
readonly RE_OCTAL='^[0-7]{3,4}$'
readonly RE_ACL_ITEM='(default:)?(user|group|other|mask|u|g|o|m):[a-z0-9_-]*:[rwxX-]{1,3}'
readonly RE_ACL_REMOVE_ITEM='(default:)?(u|g|o|m):[a-z0-9_-]*'
readonly RE_UNIT='^smart-node-[a-z0-9._-]+$'
readonly RE_CONTAINER='^(smart-node|omnivoice)-[a-z0-9._-]+$'
readonly RE_LINES='^[1-9][0-9]{0,3}$'
readonly RE_ISO_TIME='^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ][0-9]{2}:[0-9]{2}(:[0-9]{2})?(Z|[+-][0-9]{2}:?[0-9]{2})?)?$'
readonly RE_TASK_ID='^[1-9][0-9]{0,9}$'
readonly RE_SHA256='^[0-9a-f]{64}$'
# A unit file installed through unit-install may only run as an agent or a
# smart-node service account, never as root.
readonly RE_UNIT_USER='^(agent-|smart-node-)[a-z0-9-]+$'
readonly UNIT_MARKER='# installed-by: sn-op unit-install'
readonly UNIT_MAX_BYTES=16384
readonly DROPIN_MARKER='# installed-by: sn-op dropin-install'
readonly RE_DROPIN_NAME='^[0-9]{2}-[a-z0-9][a-z0-9._-]{0,59}\.conf$'
readonly RE_DROPIN_RWPATH='^-?/(var/lib|var/log)/smart-node(/[A-Za-z0-9._-]+)*$'
readonly RE_DROPIN_ANYPATH='^-?/[A-Za-z0-9._/-]*$'
readonly ROUTE_MARKER='# installed-by: sn-op route-install'
readonly RE_ROUTE_NAME='^8[0-9]-[a-z0-9][a-z0-9._-]{0,59}\.yml$'
readonly RE_DROPIN_LINE='^([A-Za-z]+)[[:space:]]*=[[:space:]]*(.+)$'

validate_group() {
    [[ "$1" =~ $RE_GROUP ]] || die_named SN_OP_ARG_GROUP "group must match $RE_GROUP, got: $1"
}

validate_user() {
    [[ "$1" =~ $RE_USER ]] || die_named SN_OP_ARG_USER "user must match $RE_USER, got: $1"
}

validate_octal() {
    [[ "$1" =~ $RE_OCTAL ]] || die_named SN_OP_ARG_MODE "mode must match $RE_OCTAL, got: $1"
}

validate_acl_spec() {
    local spec="$1"
    if [[ "$spec" == "-x" ]]; then
        # -x is not a spec itself; it flags removal and its own spec follows.
        return 0
    fi
    # A spec is a comma-list of ACL items. Try full match; awk-split for detail.
    local full_add="^${RE_ACL_ITEM}(,${RE_ACL_ITEM})*$"
    local full_rm="^${RE_ACL_REMOVE_ITEM}(,${RE_ACL_REMOVE_ITEM})*$"
    if [[ "$spec" =~ $full_add ]] || [[ "$spec" =~ $full_rm ]]; then
        return 0
    fi
    die_named SN_OP_ARG_ACL_SPEC "acl spec malformed: $spec"
}

validate_unit() {
    [[ "$1" =~ $RE_UNIT ]] || die_named SN_OP_ARG_UNIT_SHAPE "unit must match $RE_UNIT, got: $1"
}

validate_container() {
    [[ "$1" =~ $RE_CONTAINER ]] || die_named SN_OP_ARG_CONTAINER_SHAPE "container must match $RE_CONTAINER, got: $1"
}

validate_lines() {
    [[ "$1" =~ $RE_LINES ]] || die_named SN_OP_ARG_LINES "lines must match $RE_LINES (1-9999), got: $1"
}

validate_iso_time() {
    [[ "$1" =~ $RE_ISO_TIME ]] || die_named SN_OP_ARG_ISO_TIME "iso-time must match $RE_ISO_TIME, got: $1"
}

validate_task_id() {
    [[ "$1" =~ $RE_TASK_ID ]] || die_named SN_OP_APPROVAL_TASK_ID_SHAPE "task_id must match $RE_TASK_ID, got: $1"
}

# validate_path -- non-empty, absolute, no control chars, no `..` component,
# canonicalises inside /work, and (if it exists) realpath -e must equal
# realpath -m so a symlink escape at check time is refused.
#
# Sets CANONICAL_PATH on success.
CANONICAL_PATH=""
validate_path() {
    local p="$1"
    [[ -n "$p" ]] || die_named SN_OP_PATH_EMPTY "path must be non-empty"
    [[ "${p:0:1}" == "/" ]] || die_named SN_OP_PATH_NOT_ABSOLUTE "path must be absolute, got: $p"
    # Control chars: NUL is not reachable through bash args, but LF/TAB are.
    if [[ "$p" == *$'\n'* || "$p" == *$'\t'* ]]; then
        die_named SN_OP_PATH_CONTROL_CHAR "path contains control character"
    fi
    # Whitespace (space) in a path is refused as ambiguous. Legitimate /work
    # filenames never contain spaces; a space-carrying path is the shape of
    # an argument-split escape attempt. If a real /work file
    # ever needs a space in its name, the owner can rename it first.
    if [[ "$p" == *" "* ]]; then
        die_named SN_OP_PATH_WHITESPACE "path contains whitespace (space); refused as ambiguous"
    fi
    # No `..` component. Refuse BEFORE canonicalisation.
    local IFS='/'
    read -ra parts <<< "$p"
    local part
    for part in "${parts[@]}"; do
        if [[ "$part" == ".." ]]; then
            die_named SN_OP_PATH_TRAVERSAL "path contains '..' component: $p"
        fi
    done
    unset IFS
    # realpath -m resolves without requiring existence.
    local rm rp
    rm="$(realpath -m -- "$p" 2>/dev/null)" || die_named SN_OP_PATH_REALPATH "realpath -m failed for: $p"
    if [[ "$rm" != "/work" && "$rm" != "/work/"* ]]; then
        die_named SN_OP_PATH_OUTSIDE_WORK "path resolves outside /work: $rm (from $p)"
    fi
    # If path exists on disk, realpath -e must equal realpath -m. Blocks
    # symlink escapes where the link exists at check time.
    if [[ -e "$p" || -L "$p" ]]; then
        rp="$(realpath -e -- "$p" 2>/dev/null)" || die_named SN_OP_PATH_REALPATH "realpath -e failed for: $p"
        if [[ "$rp" != "$rm" ]]; then
            die_named SN_OP_PATH_SYMLINK_ESCAPE "symlink escape: realpath -e ($rp) != realpath -m ($rm)"
        fi
    fi
    CANONICAL_PATH="$rm"
}

# ---------- event emission --------------------------------------------------

_event_json() {
    # Args: verb tier outcome refuse_reason exit_code elapsed_ms approval_task_id args_json_str
    local verb="$1" tier="$2" outcome="$3" refuse="$4" exit_code="$5" elapsed="$6" approval="$7" args_json="$8"
    local actor_os="${SUDO_USER:-$(id -un)}"
    # jq -n composes safe JSON; refuse_reason/exit_code/approval_task_id are
    # optional and passed as strings ("" -> null via jq).
    jq -cn \
        --arg actor_slug 'sysadmin' \
        --arg actor_os   "$actor_os" \
        --arg verb       "$verb" \
        --arg tier       "$tier" \
        --arg outcome    "$outcome" \
        --arg refuse     "$refuse" \
        --arg exit_code  "$exit_code" \
        --arg elapsed    "$elapsed" \
        --arg approval   "$approval" \
        --argjson args   "$args_json" \
        '{
            actor: $actor_slug,
            event_type: "sysadmin.op",
            entity_type: "verb",
            entity_id: $verb,
            payload: {
                actor_slug: $actor_slug,
                actor_os: $actor_os,
                verb: $verb,
                tier: $tier,
                outcome: $outcome,
                refuse_reason: (if $refuse == "" then null else $refuse end),
                exit_code: (if $exit_code == "" then null else ($exit_code|tonumber) end),
                elapsed_ms: (if $elapsed == "" then null else ($elapsed|tonumber) end),
                approval_task_id: (if $approval == "" then null else ($approval|tonumber) end),
                args: $args,
                sn_op_version: "'"$SN_OP_VERSION"'"
            }
        }'
}

_post_event() {
    local body="$1"
    curl -sS --unix-socket "$SOCKET" -m 3 \
        -H 'Content-Type: application/json' \
        -X POST "$EVENTS_URL" -d "$body" \
        -o /dev/null -w '%{http_code}' 2>/dev/null
}

_append_fallback() {
    local body="$1"
    # Ensure the file exists with 0640 root:adm. Directory must exist.
    if [[ ! -e "$FALLBACK_LOG" ]]; then
        install -m 0640 -o root -g adm /dev/null "$FALLBACK_LOG" 2>/dev/null \
            || return 1
    fi
    printf '%s\n' "$body" >> "$FALLBACK_LOG" || return 1
    return 0
}

_emit() {
    # Try core-api first; fall back to JSONL. Return 0 iff at least one path
    # accepted the write. Caller decides FAIL-LOUD.
    local body="$1"
    [[ "$DRY_RUN" == "1" ]] && return 0
    local http
    http="$(_post_event "$body" 2>/dev/null || echo 000)"
    if [[ "$http" == "201" || "$http" == "200" ]]; then
        return 0
    fi
    if _append_fallback "$body"; then
        return 0
    fi
    return 1
}

# Refuse-emit helper (called from die_named). Keeps refuse rows visible even
# when validation fails.
_emit_refuse() {
    local name="$1" msg="$2"
    local verb="${SN_OP_CURRENT_VERB:-unknown}"
    local tier="${SN_OP_CURRENT_TIER:-?}"
    local args_json='[]'
    if [[ -n "${SN_OP_CURRENT_ARGS_JSON:-}" ]]; then
        args_json="$SN_OP_CURRENT_ARGS_JSON"
    fi
    local body
    body="$(_event_json "$verb" "$tier" "refused" "$name: $msg" "" "" "" "$args_json" 2>/dev/null)" || return 0
    _emit "$body" >/dev/null 2>&1 || true
}

# ---------- approval verification (Tier B) ----------------------------------

verify_approval() {
    # Args: task_id verb argv_json
    #
    # All checks pass -> return 0. Any fail -> die_named.
    local task_id="$1" verb="$2" argv_json="$3"
    validate_task_id "$task_id"
    if [[ "$DRY_RUN" == "1" ]]; then
        # In dry-run we do not consult core-api. Callers can set
        # SNOP_DRY_RUN_APPROVAL_OK=1 to simulate a passing approval, otherwise
        # dry-run refuses (so E17 remains a refusal in tests without a live
        # planner).
        if [[ "${SNOP_DRY_RUN_APPROVAL_OK:-0}" == "1" ]]; then
            return 0
        fi
        die_named SN_OP_APPROVAL_DRY_RUN "dry-run refuses approval unless SNOP_DRY_RUN_APPROVAL_OK=1"
    fi
    # Fetch task JSON and its comments over the unix socket.
    local task_json comments_json
    task_json="$(curl -sS --unix-socket "$SOCKET" -m 3 "$PLANNER_TASK_URL/$task_id" 2>/dev/null)" \
        || die_named SN_OP_APPROVAL_TASK_READ "cannot read task $task_id from planner"
    if ! jq -e . >/dev/null 2>&1 <<< "$task_json"; then
        die_named SN_OP_APPROVAL_TASK_READ "planner returned non-JSON for task $task_id"
    fi
    comments_json="$(curl -sS --unix-socket "$SOCKET" -m 3 "$PLANNER_TASK_URL/$task_id/comments" 2>/dev/null)" \
        || die_named SN_OP_APPROVAL_TASK_READ "cannot read comments for task $task_id"
    if ! jq -e . >/dev/null 2>&1 <<< "$comments_json"; then
        die_named SN_OP_APPROVAL_TASK_READ "planner returned non-JSON for task $task_id comments"
    fi
    # a. the owner approved it: status in_progress with approved_at set.
    # b. the approval is fresh: approved_at within FRESHNESS_SECONDS.
    #
    # Only the node owner can call approve/modify/reject (the planner refuses
    # everyone else with 403), and approve is the only decision that stamps
    # approved_at; modify leaves it null. So in_progress + approved_at IS an
    # owner approval, and the time it was given is approved_at itself.
    #
    # This replaces two checks that a real approval could never satisfy:
    # previous_status == awaiting_approval,
    # which the approve path does not write (the pipeline snapshots it on the
    # block path only), and a fresh comment authored by 'admin', which stood in
    # for "the owner approved" and named one account literally, so it failed
    # on any node whose owner is called something else or approved without a
    # note.
    local status approved_at now age
    status="$(jq -r '.status // ""' <<< "$task_json")"
    approved_at="$(jq -r '.approved_at // ""' <<< "$task_json")"
    if [[ "$status" != "in_progress" ]]; then
        die_named SN_OP_APPROVAL_STATE "task $task_id not in_progress (status=$status)"
    fi
    if [[ -z "$approved_at" ]]; then
        die_named SN_OP_APPROVAL_STATE "task $task_id has no approved_at: it was not approved by the owner"
    fi
    now="$(date +%s)"
    age="$(date -d "$approved_at" +%s 2>/dev/null)" \
        || die_named SN_OP_APPROVAL_STATE "cannot parse approved_at: $approved_at"
    if (( now - age > FRESHNESS_SECONDS )); then
        die_named SN_OP_APPROVAL_STALE "approval older than ${FRESHNESS_SECONDS}s (age $((now - age))s)"
    fi
    # d. task description or a comment authored by 'sysadmin' contains the
    # exact argv (or the sha256 digest of it).
    local argv_str argv_sha
    argv_str="$(jq -r '. | join(" ")' <<< "$argv_json")"
    # An empty argv would match any description (grep -F with an empty
    # pattern matches every line), so it can never be taken as a binding.
    [[ -n "$argv_str" ]]         || die_named SN_OP_APPROVAL_ARGV_MISMATCH "empty argv cannot be bound to an approval"
    argv_sha="$(printf '%s' "$argv_str" | sha256sum | awk '{print $1}')"
    local description
    description="$(jq -r '.description // ""' <<< "$task_json")"
    local match=0
    if grep -qF -- "$argv_str" <<< "$description"; then
        match=1
    elif grep -qF -- "$argv_sha" <<< "$description"; then
        match=1
    else
        local sysadmin_comments
        sysadmin_comments="$(jq -r '[ .[]? | select(.author == "sysadmin") | .content ] | join("\n---\n")' <<< "$comments_json")"
        if grep -qF -- "$argv_str" <<< "$sysadmin_comments"; then
            match=1
        elif grep -qF -- "$argv_sha" <<< "$sysadmin_comments"; then
            match=1
        fi
    fi
    if (( match == 0 )); then
        die_named SN_OP_APPROVAL_ARGV_MISMATCH "argv not present in task description or sysadmin comments"
    fi
    # e. no prior sn_core.events row with entity_type='verb' entity_id=<verb>
    # payload.approval_task_id=<task_id> outcome in ('exec_ok','exec_error').
    local events_json
    events_json="$(curl -sS --unix-socket "$SOCKET" -m 3 \
        "http://localhost/api/events?event_type=sysadmin.op&entity_type=verb&entity_id=$verb&limit=200" \
        2>/dev/null)" || die_named SN_OP_APPROVAL_EVENTS_READ "cannot query prior events for consumption check"
    # Fail closed: an error body is valid JSON too (a 403 from core-api reads
    # {"detail": ...}), and `.events[]?` over it counts zero prior rows, which
    # would let one approval be replayed without limit. Only an events array
    # is an answer.
    if ! jq -e '.events | type == "array"' >/dev/null 2>&1 <<< "$events_json"; then
        die_named SN_OP_APPROVAL_EVENTS_READ "events endpoint did not return an events list: $(head -c 200 <<< "$events_json")"
    fi
    local consumed
    consumed="$(jq --argjson t "$task_id" '[ .events[]? | select(.payload.approval_task_id == $t) | select(.payload.outcome == "exec_ok" or .payload.outcome == "exec_error") ] | length' <<< "$events_json")"
    if (( consumed > 0 )); then
        die_named SN_OP_APPROVAL_CONSUMED "approval task $task_id already consumed by $consumed prior exec row(s)"
    fi
    return 0
}

# ---------- exec wrapper -----------------------------------------------------

# Runs the underlying binary, times it, updates the event row with the outcome.
# Args: verb tier args_json approval_task_id -- <binary> [args...]
run_and_record() {
    local verb="$1" tier="$2" args_json="$3" approval="$4"
    shift 4
    local -a cmd=("$@")
    if [[ "$DRY_RUN" == "1" ]]; then
        printf 'would-exec:'
        printf ' %q' "${cmd[@]}"
        printf '\n'
        return 0
    fi
    # Emit "accepted" row FIRST. FAIL-LOUD if this cannot be recorded.
    local accepted_body
    accepted_body="$(_event_json "$verb" "$tier" "accepted" "" "" "" "$approval" "$args_json")"
    if ! _emit "$accepted_body"; then
        printf '[sn-op] SN_OP_EMIT_FAIL: cannot emit accepted event to core-api or fallback log\n' >&2
        exit 3
    fi
    # Exec.
    local start_ms end_ms elapsed rc=0
    start_ms="$(date +%s%3N)"
    "${cmd[@]}" || rc=$?
    end_ms="$(date +%s%3N)"
    elapsed=$(( end_ms - start_ms ))
    # Emit outcome row.
    local outcome
    if (( rc == 0 )); then outcome="exec_ok"; else outcome="exec_error"; fi
    local outcome_body
    outcome_body="$(_event_json "$verb" "$tier" "$outcome" "" "$rc" "$elapsed" "$approval" "$args_json")"
    _emit "$outcome_body" || true
    exit $rc
}

# ---------- verb dispatch ----------------------------------------------------

SN_OP_CURRENT_VERB=""
SN_OP_CURRENT_TIER=""
SN_OP_CURRENT_ARGS_JSON=""

# Compose args_json from an array. Callers pass the array by name.
# The nameref must not share a name with any caller's array: every verb passes
# an array called `arr`, and `local -n arr=arr` is a circular reference that
# bash resolves to nothing, so every event recorded args [] and the approval
# argv check compared against an empty string, which matches any task.
_args_json() {
    local -n _snop_args_ref="$1"
    local piece j="["
    local first=1
    for piece in "${_snop_args_ref[@]}"; do
        if (( first )); then first=0; else j+=","; fi
        j+="$(jq -Rn --arg s "$piece" '$s')"
    done
    j+="]"
    printf '%s' "$j"
}

usage() {
    cat <<'EOF' >&2
usage: sn-op <verb> [args...]

Tier A (reversible, no approval):
  sn-op chgrp   [-R] <group>      <path>
  sn-op chmod   [-R] <octal-mode> <path>
  sn-op setfacl [-R] <acl-spec>   <path>
  sn-op setfacl -x <acl-remove-spec> <path>
  sn-op groupadd <group>
  sn-op groupmod-rename <old-group> <new-group>
  sn-op gpasswd-add <user> <group>
  sn-op gpasswd-del <user> <group>
  sn-op mkdir [-p] <path>
  sn-op mv <src-path> <dst-path>
  sn-op service-start   <unit>
  sn-op service-restart <unit>
  sn-op service-reload  <unit>
  sn-op container-start   <name>
  sn-op container-restart <name>
  sn-op journal-tail  <unit> <lines>
  sn-op journal-since <unit> <iso-time>
  sn-op service-status  <unit>
  sn-op unit-enable     <unit>      (only units unit-install put there)
  sn-op container-status <name>

Tier B (destructive, --approval <task_id> required):
  sn-op service-stop   <unit>       --approval <task_id>
  sn-op unit-install <unit> <source-path> <sha256> --approval <task_id>
                                    installs a smart-node-*.service|timer; a
                                    service must run as agent-*/smart-node-*
  sn-op dropin-install <unit> <NN-name.conf> <source-path> <sha256> --approval <task_id>
                                    adds a [Service] drop-in to an existing smart-node-*
                                    unit: ReadWritePaths= under /var/lib/smart-node or
                                    /var/log/smart-node, ReadOnlyPaths=, InaccessiblePaths=,
                                    Restart=, RestartSec= and nothing else
  sn-op route-install <8N-name.yml> <source-path> <sha256> --approval <task_id>
                                    publishes an internal Traefik route: one
                                    Host(<x>.<node internal domain>) behind vpn-only or authum
                                    to http://host.docker.internal:PORT or 127.0.0.1:PORT
  sn-op ufw-allow-docker <port>     --approval <task_id>
                                    opens one TCP port, inside the range the node set in
                                    /etc/smart-node/sn-op-app-ports, to the node's Docker
                                    network only (where Traefik reaches the host app)
  sn-op container-stop <name>       --approval <task_id>
  sn-op rm  [-R] <path>             --approval <task_id>

Table verbs (rows of /etc/smart-node/sn-op-verbs.json, root-owned):
  sn-op verbs                       list them: name, tier, what it does, args
  sn-op run <name> [args...] [--approval <task_id>]
                                    run a row; a tier B row needs --approval

Env:
  SNOP_DRY_RUN=1   Validate and print resolved exec, do not run or emit event.
EOF
    exit 64
}

# --approval extractor. Sets globals EXTRACTED_APPROVAL and EXTRACTED_REST[]
# from the argv list, stripping the --approval <id> pair. Uses globals rather
# than a $(...) capture because bash command substitution eats NUL separators.
EXTRACTED_APPROVAL=""
EXTRACTED_REST=()
extract_approval() {
    local -a in=("$@")
    EXTRACTED_APPROVAL=""
    EXTRACTED_REST=()
    local i=0 n=${#in[@]}
    while (( i < n )); do
        if [[ "${in[$i]}" == "--approval" ]]; then
            (( i + 1 < n )) || die_named SN_OP_APPROVAL_TASK_ID_MISSING "--approval requires a task id"
            EXTRACTED_APPROVAL="${in[$((i+1))]}"
            i=$((i + 2))
        else
            EXTRACTED_REST+=("${in[$i]}")
            i=$((i + 1))
        fi
    done
}

verb_chgrp() {
    SN_OP_CURRENT_VERB=chgrp; SN_OP_CURRENT_TIER=A
    local recursive=""
    if [[ "${1:-}" == "-R" ]]; then recursive="-R"; shift; fi
    (( $# == 2 )) || die_named SN_OP_ARG_COUNT "chgrp takes [<-R>] <group> <path> (got $# non-flag arg(s))"
    local group="$1" path="$2"
    validate_group "$group"
    validate_path "$path"
    local arr=("$recursive" "$group" "$path"); [[ -z "$recursive" ]] && arr=("$group" "$path")
    local args_json; args_json="$(_args_json arr)"; SN_OP_CURRENT_ARGS_JSON="$args_json"
    if [[ -n "$recursive" ]]; then
        run_and_record chgrp A "$args_json" "" /bin/chgrp -R -- "$group" "$CANONICAL_PATH"
    else
        run_and_record chgrp A "$args_json" "" /bin/chgrp -- "$group" "$CANONICAL_PATH"
    fi
}

verb_chmod() {
    SN_OP_CURRENT_VERB=chmod; SN_OP_CURRENT_TIER=A
    local recursive=""
    if [[ "${1:-}" == "-R" ]]; then recursive="-R"; shift; fi
    (( $# == 2 )) || die_named SN_OP_ARG_COUNT "chmod takes [<-R>] <octal-mode> <path> (got $# non-flag arg(s))"
    local mode="$1" path="$2"
    validate_octal "$mode"
    validate_path "$path"
    local arr=("$recursive" "$mode" "$path"); [[ -z "$recursive" ]] && arr=("$mode" "$path")
    local args_json; args_json="$(_args_json arr)"; SN_OP_CURRENT_ARGS_JSON="$args_json"
    if [[ -n "$recursive" ]]; then
        run_and_record chmod A "$args_json" "" /bin/chmod -R -- "$mode" "$CANONICAL_PATH"
    else
        run_and_record chmod A "$args_json" "" /bin/chmod -- "$mode" "$CANONICAL_PATH"
    fi
}

verb_setfacl() {
    SN_OP_CURRENT_VERB=setfacl; SN_OP_CURRENT_TIER=A
    local recursive="" op="-m"
    while (( $# > 0 )); do
        case "$1" in
            -R) recursive="-R"; shift ;;
            -m) op="-m"; shift ;;
            -x) op="-x"; shift ;;
            *)  break ;;
        esac
    done
    (( $# == 2 )) || die_named SN_OP_ARG_COUNT "setfacl takes [<-R>] [<-m|-x>] <acl-spec> <path> (got $# non-flag arg(s))"
    local spec="$1" path="$2"
    validate_acl_spec "$spec"
    validate_path "$path"
    local -a arr=()
    [[ -n "$recursive" ]] && arr+=("$recursive")
    arr+=("$op" "$spec" "$path")
    local args_json; args_json="$(_args_json arr)"; SN_OP_CURRENT_ARGS_JSON="$args_json"
    local -a cmd=(/usr/bin/setfacl)
    [[ -n "$recursive" ]] && cmd+=("-R")
    cmd+=("$op" "$spec" "--" "$CANONICAL_PATH")
    run_and_record setfacl A "$args_json" "" "${cmd[@]}"
}

verb_groupadd() {
    SN_OP_CURRENT_VERB=groupadd; SN_OP_CURRENT_TIER=A
    (( $# == 1 )) || die_named SN_OP_ARG_COUNT "groupadd takes <group> (got $#)"
    local group="$1"
    validate_group "$group"
    local arr=("$group") args_json; args_json="$(_args_json arr)"; SN_OP_CURRENT_ARGS_JSON="$args_json"
    run_and_record groupadd A "$args_json" "" /usr/sbin/groupadd -- "$group"
}

verb_groupmod_rename() {
    SN_OP_CURRENT_VERB=groupmod-rename; SN_OP_CURRENT_TIER=A
    (( $# == 2 )) || die_named SN_OP_ARG_COUNT "groupmod-rename takes <old-group> <new-group> (got $#)"
    local old="$1" new="$2"
    validate_group "$old"
    validate_group "$new"
    local arr=("$old" "$new") args_json; args_json="$(_args_json arr)"; SN_OP_CURRENT_ARGS_JSON="$args_json"
    run_and_record groupmod-rename A "$args_json" "" /usr/sbin/groupmod -n "$new" "$old"
}

verb_gpasswd_add() {
    SN_OP_CURRENT_VERB=gpasswd-add; SN_OP_CURRENT_TIER=A
