# Tier B ---------------------------------------------------------------------

verb_service_stop() {
    SN_OP_CURRENT_VERB=service-stop; SN_OP_CURRENT_TIER=B
    extract_approval "$@"
    local approval="$EXTRACTED_APPROVAL"
    local -a rest=("${EXTRACTED_REST[@]}")
    [[ -n "$approval" ]] || die_named SN_OP_APPROVAL_REQUIRED "service-stop requires --approval <task_id>"
    (( ${#rest[@]} == 1 )) || die_named SN_OP_ARG_COUNT "service-stop takes <unit> (got ${#rest[@]})"
    local unit="${rest[0]}"
    validate_unit "$unit"
    local arr=("$unit") args_json; args_json="$(_args_json arr)"; SN_OP_CURRENT_ARGS_JSON="$args_json"
    verify_approval "$approval" service-stop "$args_json"
    run_and_record service-stop B "$args_json" "$approval" /bin/systemctl stop -- "$unit"
}

verb_container_stop() {
    SN_OP_CURRENT_VERB=container-stop; SN_OP_CURRENT_TIER=B
    extract_approval "$@"
    local approval="$EXTRACTED_APPROVAL"
    local -a rest=("${EXTRACTED_REST[@]}")
    [[ -n "$approval" ]] || die_named SN_OP_APPROVAL_REQUIRED "container-stop requires --approval <task_id>"
    (( ${#rest[@]} == 1 )) || die_named SN_OP_ARG_COUNT "container-stop takes <name> (got ${#rest[@]})"
    local name="${rest[0]}"
    validate_container "$name"
    local arr=("$name") args_json; args_json="$(_args_json arr)"; SN_OP_CURRENT_ARGS_JSON="$args_json"
    verify_approval "$approval" container-stop "$args_json"
    run_and_record container-stop B "$args_json" "$approval" /usr/bin/docker stop -- "$name"
}

verb_rm() {
    SN_OP_CURRENT_VERB=rm; SN_OP_CURRENT_TIER=B
    extract_approval "$@"
    local approval="$EXTRACTED_APPROVAL"
    local -a rest=("${EXTRACTED_REST[@]}")
    [[ -n "$approval" ]] || die_named SN_OP_APPROVAL_REQUIRED "rm requires --approval <task_id>"
    local recursive=""
    if [[ "${rest[0]:-}" == "-R" ]]; then recursive="-R"; rest=("${rest[@]:1}"); fi
    (( ${#rest[@]} == 1 )) || die_named SN_OP_ARG_COUNT "rm takes [<-R>] <path> (got ${#rest[@]} non-flag arg(s))"
    local path="${rest[0]}"
    validate_path "$path"
    local arr=("$recursive" "$path"); [[ -z "$recursive" ]] && arr=("$path")
    local args_json; args_json="$(_args_json arr)"; SN_OP_CURRENT_ARGS_JSON="$args_json"
    verify_approval "$approval" rm "$args_json"
    if [[ -n "$recursive" ]]; then
        run_and_record rm B "$args_json" "$approval" /bin/rm -rf -- "$CANONICAL_PATH"
    else
        run_and_record rm B "$args_json" "$approval" /bin/rm -- "$CANONICAL_PATH"
    fi
}

# ---------- unit files -------------------------------------------------------
#
# A unit file is code that systemd runs, by default as root. The unit NAME is
# therefore not the boundary; the CONTENT is. unit-install copies the source
# once into a private root-only directory, then checks the sha256, the shape
# and the privileges of the copy, so nothing can change between the check and
# the install.

# _unit_check_content <file> <unit>: named refusal unless the file is safe to
# install under that unit name.
_unit_check_content() {
    local f="$1" unit="$2" size
    size="$(stat -c %s -- "$f")"
    (( size > 0 && size <= UNIT_MAX_BYTES )) \
        || die_named SN_OP_UNIT_SIZE "unit file must be 1..$UNIT_MAX_BYTES bytes, got $size"
    # A trailing backslash joins lines, which hides a prefix such as + from the
    # per-line checks below. No legitimate monitor unit needs it.
    if grep -q '\\$' -- "$f"; then
        die_named SN_OP_UNIT_CONTINUATION "line continuation (trailing backslash) is not allowed"
    fi
    if [[ "$unit" == *.timer ]]; then
        # A timer starts another unit; it may only start one we are allowed to name.
        local target
        while IFS= read -r target; do
            target="${target%"${target##*[![:space:]]}"}"
            [[ "$target" =~ $RE_UNIT ]] \
                || die_named SN_OP_UNIT_TIMER_TARGET "timer Unit= must match $RE_UNIT, got: $target"
        done < <(sed -n 's/^[[:space:]]*Unit=[[:space:]]*//p' -- "$f")
        return 0
    fi
    # .service: every User= must be an agent or service account, and there must
    # be at least one, because no User= means root.
    local -a users=()
    mapfile -t users < <(sed -n 's/^[[:space:]]*User=[[:space:]]*//p' -- "$f")
    (( ${#users[@]} >= 1 )) \
        || die_named SN_OP_UNIT_RUNS_AS_ROOT "service has no User=, so it would run as root"
    local u
    for u in "${users[@]}"; do
        u="${u%"${u##*[![:space:]]}"}"
        [[ "$u" =~ $RE_UNIT_USER ]] \
            || die_named SN_OP_UNIT_RUNS_AS_ROOT "User= must match $RE_UNIT_USER, got: $u"
    done
    # + and ! prefixes make systemd run that command with full privileges,
    # ignoring User=. Prefixes combine (-+, @!), so look past the others.
    if grep -Eq '^[[:space:]]*Exec[A-Za-z]*=[[:space:]]*[-@:]*[+!]' -- "$f"; then
        die_named SN_OP_UNIT_RUNS_AS_ROOT "an Exec line starts with + or !, which runs it as root"
    fi
    if grep -Eiq '^[[:space:]]*(PermissionsStartOnly|AmbientCapabilities)[[:space:]]*=' -- "$f"; then
        die_named SN_OP_UNIT_ELEVATES "PermissionsStartOnly= and AmbientCapabilities= are not allowed"
    fi
    return 0
}

# _unit_exists <unit>: 0 if a unit of that name is already known to systemd on disk.
_unit_exists() {
    local d
    for d in "$UNIT_DIR" /lib/systemd/system /usr/lib/systemd/system; do
        [[ -e "$d/$1" || -L "$d/$1" ]] && return 0
    done
    return 1
}

# _unit_ours <unit>: 0 if the unit in UNIT_DIR carries our marker.
_unit_ours() {
    [[ -f "$UNIT_DIR/$1" && ! -L "$UNIT_DIR/$1" ]] \
        && [[ "$(head -n1 -- "$UNIT_DIR/$1")" == "$UNIT_MARKER" ]]
}

# Runs as the exec step of unit-install (called through run_and_record).
# Args: <private-copy> <unit>
_do_unit_install() {
    local copy="$1" unit="$2" tmp
    tmp="$(mktemp -- "$UNIT_DIR/.snop-unit.XXXXXX")" || return 1
    { printf '%s\n' "$UNIT_MARKER"; cat -- "$copy"; } > "$tmp" || { rm -f -- "$tmp"; return 1; }
    chown root:root -- "$tmp" && chmod 0644 -- "$tmp" || { rm -f -- "$tmp"; return 1; }
    mv -T -- "$tmp" "$UNIT_DIR/$unit" || { rm -f -- "$tmp"; return 1; }
    /bin/systemctl daemon-reload
}

verb_unit_install() {
    SN_OP_CURRENT_VERB=unit-install; SN_OP_CURRENT_TIER=B
    extract_approval "$@"
    local approval="$EXTRACTED_APPROVAL"
    local -a rest=("${EXTRACTED_REST[@]}")
    [[ -n "$approval" ]] || die_named SN_OP_APPROVAL_REQUIRED "unit-install requires --approval <task_id>"
    (( ${#rest[@]} == 3 )) || die_named SN_OP_ARG_COUNT "unit-install takes <unit> <source-path> <sha256> (got ${#rest[@]})"
    local unit="${rest[0]}" src="${rest[1]}" want="${rest[2]}"
    validate_unit "$unit"
    [[ "$unit" == *.service || "$unit" == *.timer ]] \
        || die_named SN_OP_UNIT_SUFFIX "unit must end in .service or .timer, got: $unit"
    [[ "$want" =~ $RE_SHA256 ]] || die_named SN_OP_ARG_SHA256 "sha256 must match $RE_SHA256, got: $want"
    validate_path "$src"
    [[ -f "$CANONICAL_PATH" ]] || die_named SN_OP_UNIT_SOURCE "source is not a regular file: $src"
    local arr=("$unit" "$src" "$want") args_json; args_json="$(_args_json arr)"; SN_OP_CURRENT_ARGS_JSON="$args_json"
    # One read of the source, into a directory only root can enter.
    local priv; priv="$(mktemp -d)"
    # shellcheck disable=SC2064
    trap "rm -rf -- '$priv'" EXIT
    cat -- "$CANONICAL_PATH" > "$priv/unit" || die_named SN_OP_UNIT_SOURCE "cannot read $src"
    local got; got="$(sha256sum -- "$priv/unit" | awk '{print $1}')"
    [[ "$got" == "$want" ]] || die_named SN_OP_UNIT_SHA_MISMATCH "sha256 of $src is $got, argv says $want"
    _unit_check_content "$priv/unit" "$unit"
    # Never replace a unit the product ships or one somebody else installed:
    # only a unit that already carries our marker may be replaced.
    if _unit_exists "$unit" && ! _unit_ours "$unit"; then
        die_named SN_OP_UNIT_EXISTS "$unit already exists and was not installed by unit-install"
    fi
    verify_approval "$approval" unit-install "$args_json"
    run_and_record unit-install B "$args_json" "$approval" _do_unit_install "$priv/unit" "$unit"
}

verb_unit_enable() {
    SN_OP_CURRENT_VERB=unit-enable; SN_OP_CURRENT_TIER=A
    (( $# == 1 )) || die_named SN_OP_ARG_COUNT "unit-enable takes <unit> (got $#)"
    local unit="$1"
    validate_unit "$unit"
    [[ "$unit" == *.service || "$unit" == *.timer ]] \
        || die_named SN_OP_UNIT_SUFFIX "unit must end in .service or .timer, got: $unit"
    # Only what unit-install put there: enabling a shipped unit is not this verb's job.
    _unit_ours "$unit" || die_named SN_OP_UNIT_NOT_OURS "$unit was not installed by unit-install"
    local arr=("$unit") args_json; args_json="$(_args_json arr)"; SN_OP_CURRENT_ARGS_JSON="$args_json"
    run_and_record unit-enable A "$args_json" "" /bin/systemctl enable --now -- "$unit"
}

# ---------- drop-ins -----------------------------------------------------------
#
# A drop-in changes how an existing unit runs, so what it may say is an
# allowlist, not a list of things to refuse. See the header for the keys.

_dropin_check_content() {
    local f="$1" size line key val p section=0
    local -a parts=()
    size="$(stat -c %s -- "$f")"
    (( size > 0 && size <= UNIT_MAX_BYTES )) \
        || die_named SN_OP_UNIT_SIZE "drop-in must be 1..$UNIT_MAX_BYTES bytes, got $size"
    if grep -q '\\$' -- "$f"; then
        die_named SN_OP_DROPIN_CONTINUATION "line continuation (trailing backslash) is not allowed"
    fi
    while IFS= read -r line || [[ -n "$line" ]]; do
        line="${line#"${line%%[![:space:]]*}"}"
        line="${line%"${line##*[![:space:]]}"}"
        [[ -z "$line" || "${line:0:1}" == "#" || "${line:0:1}" == ";" ]] && continue
        if [[ "${line:0:1}" == "[" ]]; then
            [[ "$line" == "[Service]" ]] \
                || die_named SN_OP_DROPIN_SECTION "only a [Service] section is allowed, got: $line"
            section=1
            continue
        fi
        (( section == 1 )) || die_named SN_OP_DROPIN_SECTION "settings must come under [Service]: $line"
        [[ "$line" =~ $RE_DROPIN_LINE ]] \
            || die_named SN_OP_DROPIN_KEY "malformed line (an empty value is not allowed): $line"
        key="${BASH_REMATCH[1]}"; val="${BASH_REMATCH[2]}"
        read -ra parts <<< "$val"
        case "$key" in
            ReadWritePaths)
                for p in "${parts[@]}"; do
                    [[ "$p" =~ $RE_DROPIN_RWPATH && "$p" != *..* ]] \
                        || die_named SN_OP_DROPIN_PATH "ReadWritePaths= may only name a path under /var/lib/smart-node or /var/log/smart-node, got: $p"
                done ;;
            ReadOnlyPaths|InaccessiblePaths)
                for p in "${parts[@]}"; do
                    [[ "$p" =~ $RE_DROPIN_ANYPATH && "$p" != *..* ]] \
                        || die_named SN_OP_DROPIN_PATH "$key= needs absolute paths without '..', got: $p"
                done ;;
            Restart)
                [[ "$val" =~ ^(no|on-failure|on-abnormal|always)$ ]] \
                    || die_named SN_OP_DROPIN_KEY "Restart= must be no, on-failure, on-abnormal or always, got: $val" ;;
            RestartSec)
                [[ "$val" =~ ^[0-9]{1,4}(s|min)?$ ]] \
                    || die_named SN_OP_DROPIN_KEY "RestartSec= must be like 5, 5s or 2min, got: $val" ;;
            *)
                die_named SN_OP_DROPIN_KEY "$key= is not allowed in a drop-in installed this way" ;;
        esac
    done < "$f"
    (( section == 1 )) || die_named SN_OP_DROPIN_SECTION "the drop-in has no [Service] section"
}

# _dropin_ours <unit> <name>: 0 if that drop-in file carries our marker.
_dropin_ours() {
    local f="$UNIT_DIR/$1.d/$2"
    [[ -f "$f" && ! -L "$f" ]] && [[ "$(head -n1 -- "$f")" == "$DROPIN_MARKER" ]]
}

# Exec step of dropin-install. Args: <private-copy> <unit> <name>
_do_dropin_install() {
    local copy="$1" unit="$2" name="$3" d tmp
    d="$UNIT_DIR/$unit.d"
    /usr/bin/install -m 0755 -d -- "$d" || return 1
    tmp="$(mktemp -- "$d/.snop-dropin.XXXXXX")" || return 1
    { printf '%s\n' "$DROPIN_MARKER"; cat -- "$copy"; } > "$tmp" || { rm -f -- "$tmp"; return 1; }
    chown root:root -- "$tmp" && chmod 0644 -- "$tmp" || { rm -f -- "$tmp"; return 1; }
    mv -T -- "$tmp" "$d/$name" || { rm -f -- "$tmp"; return 1; }
    /bin/systemctl daemon-reload
}

verb_dropin_install() {
    SN_OP_CURRENT_VERB=dropin-install; SN_OP_CURRENT_TIER=B
    extract_approval "$@"
    local approval="$EXTRACTED_APPROVAL"
    local -a rest=("${EXTRACTED_REST[@]}")
    [[ -n "$approval" ]] || die_named SN_OP_APPROVAL_REQUIRED "dropin-install requires --approval <task_id>"
    (( ${#rest[@]} == 4 )) \
        || die_named SN_OP_ARG_COUNT "dropin-install takes <unit> <NN-name.conf> <source-path> <sha256> (got ${#rest[@]})"
    local unit="${rest[0]}" name="${rest[1]}" src="${rest[2]}" want="${rest[3]}"
    validate_unit "$unit"
    [[ "$unit" == *.service || "$unit" == *.timer ]] \
        || die_named SN_OP_UNIT_SUFFIX "unit must end in .service or .timer, got: $unit"
    [[ "$name" =~ $RE_DROPIN_NAME ]] \
        || die_named SN_OP_ARG_DROPIN_NAME "drop-in name must match $RE_DROPIN_NAME, got: $name"
    [[ "$want" =~ $RE_SHA256 ]] || die_named SN_OP_ARG_SHA256 "sha256 must match $RE_SHA256, got: $want"
    validate_path "$src"
    [[ -f "$CANONICAL_PATH" ]] || die_named SN_OP_UNIT_SOURCE "source is not a regular file: $src"
    local arr=("$unit" "$name" "$src" "$want") args_json; args_json="$(_args_json arr)"; SN_OP_CURRENT_ARGS_JSON="$args_json"
    local priv; priv="$(mktemp -d)"
    # shellcheck disable=SC2064
    trap "rm -rf -- '$priv'" EXIT
    cat -- "$CANONICAL_PATH" > "$priv/dropin" || die_named SN_OP_UNIT_SOURCE "cannot read $src"
    local got; got="$(sha256sum -- "$priv/dropin" | awk '{print $1}')"
    [[ "$got" == "$want" ]] || die_named SN_OP_UNIT_SHA_MISMATCH "sha256 of $src is $got, argv says $want"
    _dropin_check_content "$priv/dropin"
    _unit_exists "$unit" || die_named SN_OP_DROPIN_NO_UNIT "$unit does not exist; a drop-in only changes an existing unit"
    [[ ! -L "$UNIT_DIR/$unit.d" ]] || die_named SN_OP_DROPIN_EXISTS "$unit.d is a symlink"
    if [[ -e "$UNIT_DIR/$unit.d/$name" || -L "$UNIT_DIR/$unit.d/$name" ]] && ! _dropin_ours "$unit" "$name"; then
        die_named SN_OP_DROPIN_EXISTS "$unit.d/$name already exists and was not installed by dropin-install"
    fi
    verify_approval "$approval" dropin-install "$args_json"
    run_and_record dropin-install B "$args_json" "$approval" _do_dropin_install "$priv/dropin" "$unit" "$name"
}

# ---------- internal routes ----------------------------------------------------
#
# A route changes what the public front door of the node answers, so what a file
# may say is an allowlist, checked by python (yaml.safe_load) on the private copy.

read -r -d '' ROUTE_CHECK_PY <<'PYEOF' || true
import os, re, sys
import yaml

path, ddir, myname, domain = sys.argv[1:5]
ACCESS = {"vpn-only@file", "smart-node-auth@docker"}
RE_NAME = re.compile(r"^smart-node-[a-z0-9-]{1,50}$")
RE_RULE = re.compile(r"^Host\(`([a-z0-9][a-z0-9-]{0,40})\." + re.escape(domain) + r"`\)$")
RE_URL = re.compile(r"^http://(host\.docker\.internal|127\.0\.0\.1):([0-9]{4,5})/?$")

def bad(msg):
    print(msg)
    sys.exit(1)

try:
    doc = yaml.safe_load(open(path))
except Exception as e:
    bad("not valid YAML: %s" % e)
if not isinstance(doc, dict) or set(doc) != {"http"}:
    bad("the top level must be exactly: http")
http = doc["http"]
if not isinstance(http, dict) or set(http) != {"routers", "services"}:
    bad("http must hold exactly routers and services")
routers, services = http["routers"], http["services"]
if not isinstance(routers, dict) or not routers or not isinstance(services, dict) or not services:
    bad("routers and services must be non-empty mappings")

hosts = []
for name, r in routers.items():
    if not RE_NAME.match(str(name)):
        bad("router name %s must match %s" % (name, RE_NAME.pattern))
    if not isinstance(r, dict) or not set(r) <= {"rule", "entryPoints", "service", "middlewares", "tls"}:
        bad("router %s may only have rule, entryPoints, service, middlewares, tls" % name)
    m = RE_RULE.match(str(r.get("rule", "")))
    if not m:
        bad("router %s rule must be exactly Host(`<name>.%s`)" % (name, domain))
    hosts.append(m.group(0))
    if r.get("entryPoints") != ["websecure"]:
        bad("router %s entryPoints must be [websecure]" % name)
    if r.get("tls") != {}:
        bad("router %s tls must be {}" % name)
    if r.get("service") not in services:
        bad("router %s names a service this file does not define" % name)
    mw = r.get("middlewares")
    if not isinstance(mw, list) or not mw or not set(mw) <= ACCESS:
        bad("router %s middlewares must be a non-empty list from %s" % (name, sorted(ACCESS)))

for name, sv in services.items():
    if not RE_NAME.match(str(name)):
        bad("service name %s must match %s" % (name, RE_NAME.pattern))
    lb = sv.get("loadBalancer") if isinstance(sv, dict) and set(sv) == {"loadBalancer"} else None
    if not isinstance(lb, dict) or not set(lb) <= {"servers", "passHostHeader"}:
        bad("service %s must be only a loadBalancer with servers (and passHostHeader)" % name)
    if "passHostHeader" in lb and not isinstance(lb["passHostHeader"], bool):
        bad("service %s passHostHeader must be true or false" % name)
    servers = lb.get("servers")
    if not isinstance(servers, list) or not servers:
        bad("service %s needs at least one server" % name)
    for sr in servers:
        m = RE_URL.match(str(sr.get("url", ""))) if isinstance(sr, dict) and set(sr) == {"url"} else None
        if not m or not 1024 <= int(m.group(2)) <= 65535:
            bad("service %s server must be {url: http://host.docker.internal|127.0.0.1:PORT/} with PORT 1024..65535" % name)

for fn in sorted(os.listdir(ddir)):
    if fn == myname or not os.path.isfile(os.path.join(ddir, fn)):
        continue
    try:
        text = open(os.path.join(ddir, fn)).read()
    except OSError:
        continue
    for h in hosts:
        if h in text:
            bad("%s is already routed by %s" % (h, fn))
    for name in list(routers) + list(services):
        if re.search(r"(?m)^\s+['\"]?%s['\"]?\s*:" % re.escape(str(name)), text):
            bad("the name %s is already used in %s" % (name, fn))
PYEOF

# The node's internal domain, from its root-owned file. No file, no domain, no route.
_route_domain() {
    local f="$ROUTE_DOMAIN_FILE" d
    [[ -f "$f" && ! -L "$f" ]] \
        || die_named SN_OP_ROUTE_DOMAIN "no internal domain configured: $f must hold one line, the node's internal domain"
    _trusted_path "$f" || die_named SN_OP_ROUTE_DOMAIN "$f must be owned by root and writable by no one else"
    d="$(head -n1 -- "$f" | tr -d '[:space:]')"
    [[ "$d" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$ ]] \
        || die_named SN_OP_ROUTE_DOMAIN "$f does not hold a domain name"
    printf '%s' "$d"
}

_route_check_content() {
    local f="$1" size msg
    size="$(stat -c %s -- "$f")"
    (( size > 0 && size <= UNIT_MAX_BYTES )) \
        || die_named SN_OP_ROUTE_SIZE "route file must be 1..$UNIT_MAX_BYTES bytes, got $size"
    msg="$(/usr/bin/python3 -I -c "$ROUTE_CHECK_PY" "$f" "$TRAEFIK_DIR" "$2" "$3" 2>&1)" \
        || die_named SN_OP_ROUTE_CONTENT "${msg//$'\n'/ }"
}

_route_ours() {
    local f="$TRAEFIK_DIR/$1"
    [[ -f "$f" && ! -L "$f" ]] && [[ "$(head -n1 -- "$f")" == "$ROUTE_MARKER" ]]
}

# Exec step of route-install. Args: <private-copy> <name>
_do_route_install() {
    local copy="$1" name="$2" tmp
    tmp="$(mktemp -- "$TRAEFIK_DIR/.snop-route.XXXXXX.tmp")" || return 1
    { printf '%s\n' "$ROUTE_MARKER"; cat -- "$copy"; } > "$tmp" || { rm -f -- "$tmp"; return 1; }
    chown root:smart-node -- "$tmp" && chmod 0640 -- "$tmp" || { rm -f -- "$tmp"; return 1; }
    mv -T -- "$tmp" "$TRAEFIK_DIR/$name" || { rm -f -- "$tmp"; return 1; }
}

verb_route_install() {
    SN_OP_CURRENT_VERB=route-install; SN_OP_CURRENT_TIER=B
    extract_approval "$@"
    local approval="$EXTRACTED_APPROVAL"
    local -a rest=("${EXTRACTED_REST[@]}")
    [[ -n "$approval" ]] || die_named SN_OP_APPROVAL_REQUIRED "route-install requires --approval <task_id>"
    (( ${#rest[@]} == 3 )) \
        || die_named SN_OP_ARG_COUNT "route-install takes <8N-name.yml> <source-path> <sha256> (got ${#rest[@]})"
    local name="${rest[0]}" src="${rest[1]}" want="${rest[2]}"
    [[ "$name" =~ $RE_ROUTE_NAME ]] \
        || die_named SN_OP_ARG_ROUTE_NAME "route name must match $RE_ROUTE_NAME, got: $name"
    [[ "$want" =~ $RE_SHA256 ]] || die_named SN_OP_ARG_SHA256 "sha256 must match $RE_SHA256, got: $want"
    validate_path "$src"
    [[ -f "$CANONICAL_PATH" ]] || die_named SN_OP_UNIT_SOURCE "source is not a regular file: $src"
    local arr=("$name" "$src" "$want") args_json; args_json="$(_args_json arr)"; SN_OP_CURRENT_ARGS_JSON="$args_json"
    local priv; priv="$(mktemp -d)"
    # shellcheck disable=SC2064
    trap "rm -rf -- '$priv'" EXIT
    cat -- "$CANONICAL_PATH" > "$priv/route" || die_named SN_OP_UNIT_SOURCE "cannot read $src"
    local got; got="$(sha256sum -- "$priv/route" | awk '{print $1}')"
    [[ "$got" == "$want" ]] || die_named SN_OP_UNIT_SHA_MISMATCH "sha256 of $src is $got, argv says $want"
    [[ -d "$TRAEFIK_DIR" && ! -L "$TRAEFIK_DIR" ]] || die_named SN_OP_ROUTE_DIR "$TRAEFIK_DIR is not a directory"
    if [[ -e "$TRAEFIK_DIR/$name" || -L "$TRAEFIK_DIR/$name" ]] && ! _route_ours "$name"; then
        die_named SN_OP_ROUTE_EXISTS "$name already exists and was not installed by route-install"
    fi
    # Read here, not inside the $(...) of the check: a refusal in a subshell would not stop the verb.
    local domain; domain="$(_route_domain)"
    _route_check_content "$priv/route" "$name" "$domain"
    verify_approval "$approval" route-install "$args_json"
    run_and_record route-install B "$args_json" "$approval" _do_route_install "$priv/route" "$name"
}

# ---------- app ports ----------------------------------------------------------

# The Docker subnet of this node: a private range, from routing.env.
_docker_subnet() {
    local f="$ROUTING_ENV" v
    [[ -f "$f" && ! -L "$f" ]] || die_named SN_OP_UFW_CONFIG "no routing contract at $f"
    _trusted_path "$f" || die_named SN_OP_UFW_CONFIG "$f must be owned by root and writable by no one else"
    v="$(sed -n 's/^SMART_NODE_DOCKER_SUBNET=//p' "$f" | head -n1 | tr -d '[:space:]')"
    [[ "$v" =~ ^(10(\.[0-9]{1,3}){3}/([89]|1[0-9]|2[0-4])|172\.(1[6-9]|2[0-9]|3[01])(\.[0-9]{1,3}){2}/(1[2-9]|2[0-4])|192\.168(\.[0-9]{1,3}){2}/(1[6-9]|2[0-4]))$ ]] \
        || die_named SN_OP_UFW_CONFIG "SMART_NODE_DOCKER_SUBNET in $f is not a private subnet"
    printf '%s' "$v"
}

# The ports an app may use: LOW-HIGH, from a root-owned file. No file, no verb.
_app_port_range() {
    local f="$APP_PORTS_FILE" v
    [[ -f "$f" && ! -L "$f" ]] \
        || die_named SN_OP_UFW_CONFIG "no app port range configured: $f must hold one line, LOW-HIGH"
    _trusted_path "$f" || die_named SN_OP_UFW_CONFIG "$f must be owned by root and writable by no one else"
    v="$(head -n1 -- "$f" | tr -d '[:space:]')"
    [[ "$v" =~ ^([0-9]{4,5})-([0-9]{4,5})$ ]] \
        || die_named SN_OP_UFW_CONFIG "$f does not hold LOW-HIGH"
    (( BASH_REMATCH[1] >= 1024 && BASH_REMATCH[1] <= BASH_REMATCH[2] && BASH_REMATCH[2] <= 65535 )) \
        || die_named SN_OP_UFW_CONFIG "$f must hold a range inside 1024-65535"
    printf '%s' "$v"
}

# Exec step of ufw-allow-docker. Args: <subnet> <port>
_do_ufw_allow_docker() {
    /usr/sbin/ufw allow from "$1" to any port "$2" proto tcp comment "sn-op: app port $2"
}

verb_ufw_allow_docker() {
    SN_OP_CURRENT_VERB=ufw-allow-docker; SN_OP_CURRENT_TIER=B
    extract_approval "$@"
    local approval="$EXTRACTED_APPROVAL"
    local -a rest=("${EXTRACTED_REST[@]}")
    [[ -n "$approval" ]] || die_named SN_OP_APPROVAL_REQUIRED "ufw-allow-docker requires --approval <task_id>"
    (( ${#rest[@]} == 1 )) || die_named SN_OP_ARG_COUNT "ufw-allow-docker takes <port> (got ${#rest[@]})"
    local port="${rest[0]}"
    [[ "$port" =~ ^[1-9][0-9]{3,4}$ ]] || die_named SN_OP_ARG_PORT "port must be a number, got: $port"
    local arr=("$port") args_json; args_json="$(_args_json arr)"; SN_OP_CURRENT_ARGS_JSON="$args_json"
    local range subnet
    range="$(_app_port_range)"
    subnet="$(_docker_subnet)"
    (( port >= ${range%-*} && port <= ${range#*-} )) \
        || die_named SN_OP_UFW_PORT "port $port is outside the range $range this node lets an app open"
    verify_approval "$approval" ufw-allow-docker "$args_json"
    run_and_record ufw-allow-docker B "$args_json" "$approval" _do_ufw_allow_docker "$subnet" "$port"
}

# ---------- table verbs (run, verbs) -------------------------------------------

# Who must own a trusted file: root, or (dry run on a fixture table only) the
# user running the test.
_want_owner() {
    if [[ "$DRY_RUN" == "1" && ( -n "${SNOP_DRY_RUN_VERB_TABLE:-}" || -n "${SNOP_DRY_RUN_ROUTE_DOMAIN_FILE:-}" \
            || -n "${SNOP_DRY_RUN_ROUTING_ENV:-}" || -n "${SNOP_DRY_RUN_APP_PORTS_FILE:-}" ) ]]; then id -u; else echo 0; fi
}

# Owned by the wanted user and not writable by group or others.
_trusted_path() {
    local p="$1" owner mode
    owner="$(stat -c '%u' -- "$p" 2>/dev/null)" || return 1
    mode="$(stat -c '%a' -- "$p" 2>/dev/null)" || return 1
    [[ "$owner" == "$(_want_owner)" ]] || return 1
    (( (8#$mode & 8#022) == 0 ))
}

# Where a table row may point its executable.
_exec_allowed() {
    local p="$1"
    case "$p" in
        /opt/smart-node/*|/usr/local/sbin/*) return 0 ;;
    esac
    if [[ "$DRY_RUN" == "1" && -n "${SNOP_DRY_RUN_VERB_TABLE:-}" ]]; then
        [[ "$p" == "$(dirname "$SNOP_DRY_RUN_VERB_TABLE")"/* ]] && return 0
    fi
    return 1
}

_table_check() {
    [[ -f "$VERB_TABLE" ]] || die_named SN_OP_RUN_NO_TABLE "no verb table at $VERB_TABLE"
    _trusted_path "$VERB_TABLE" \
        || die_named SN_OP_RUN_TABLE_UNTRUSTED "$VERB_TABLE must be owned by root and not writable by group or others"
    _trusted_path "$(dirname "$VERB_TABLE")" \
        || die_named SN_OP_RUN_TABLE_UNTRUSTED "the directory of $VERB_TABLE must be owned by root and not writable by group or others"
    jq -e '.verbs | type == "object"' "$VERB_TABLE" >/dev/null 2>&1 \
        || die_named SN_OP_RUN_TABLE_PARSE "$VERB_TABLE is not JSON with a \"verbs\" object"
}

verb_verbs() {
    SN_OP_CURRENT_VERB=verbs; SN_OP_CURRENT_TIER=A
    (( $# == 0 )) || die_named SN_OP_ARG_COUNT "verbs takes no arguments (got $#)"
    _table_check
    jq -r '.verbs | to_entries[] | "\(.key)\t\(.value.tier // "A")\t\(.value.description // "")\t\((.value.args // []) | length) arg(s)"' "$VERB_TABLE"
}

verb_run() {
    SN_OP_CURRENT_VERB=run; SN_OP_CURRENT_TIER=A
    extract_approval "$@"
    local approval="$EXTRACTED_APPROVAL"
    local -a rest=("${EXTRACTED_REST[@]}")
    (( ${#rest[@]} >= 1 )) || die_named SN_OP_ARG_COUNT "run takes <name> [args...] (see: sn-op verbs)"
    local name="${rest[0]}"
    rest=("${rest[@]:1}")
    [[ "$name" =~ $RE_TABLE_VERB ]] || die_named SN_OP_RUN_NAME_SHAPE "name must match $RE_TABLE_VERB, got: $name"
    SN_OP_CURRENT_VERB="run:$name"
    _table_check

    local entry
    entry="$(jq -c --arg n "$name" '.verbs[$n] // empty' "$VERB_TABLE" 2>/dev/null)" \
        || die_named SN_OP_RUN_TABLE_PARSE "cannot read $VERB_TABLE"
    [[ -n "$entry" ]] || die_named SN_OP_RUN_UNKNOWN "no verb '$name' in $VERB_TABLE (see: sn-op verbs)"
    jq -e '(.exec | type == "array" and length > 0 and all(.[]; type == "string"))
           and ((.args // []) | type == "array" and all(.[]; type == "string"))
           and ((.tier // "A") | . == "A" or . == "B")' <<< "$entry" >/dev/null 2>&1 \
        || die_named SN_OP_RUN_TABLE_ENTRY "the row for '$name' needs exec (list of strings), optional args (regexes) and tier A or B"
    local tier
    tier="$(jq -r '.tier // "A"' <<< "$entry")"
    SN_OP_CURRENT_TIER="$tier"

    local -a exe=() res=()
    mapfile -t exe < <(jq -r '.exec[]' <<< "$entry")
    mapfile -t res < <(jq -r '(.args // [])[]' <<< "$entry")

    # The executable: absolute, no '..', no symlink anywhere on its path, in an
    # allowed place, a regular executable file nobody else can rewrite.
    local bin="${exe[0]}"
    [[ "${bin:0:1}" == "/" ]] || die_named SN_OP_RUN_EXEC "exec of '$name' must be an absolute path: $bin"
    [[ "$bin" != *..* ]] || die_named SN_OP_RUN_EXEC "exec of '$name' contains '..': $bin"
    _exec_allowed "$bin" || die_named SN_OP_RUN_EXEC "exec of '$name' is outside /opt/smart-node and /usr/local/sbin: $bin"
    [[ "$(realpath -e -- "$bin" 2>/dev/null)" == "$bin" ]] \
        || die_named SN_OP_RUN_EXEC "exec of '$name' is missing or reached through a symlink: $bin"
    [[ -f "$bin" && -x "$bin" ]] || die_named SN_OP_RUN_EXEC "exec of '$name' is not an executable file: $bin"
    _trusted_path "$bin" || die_named SN_OP_RUN_EXEC "exec of '$name' must be owned by root and not writable by others: $bin"

    # The arguments: exact count, each one whole-matching its own regex.
    (( ${#rest[@]} == ${#res[@]} )) \
        || die_named SN_OP_ARG_COUNT "run $name takes ${#res[@]} argument(s) (got ${#rest[@]})"
    local i arg re
    for (( i = 0; i < ${#rest[@]}; i++ )); do
        arg="${rest[$i]}"
        [[ "${arg:0:1}" != "-" ]] || die_named SN_OP_RUN_ARG_OPTION "argument $((i+1)) of '$name' starts with '-': $arg"
        (( ${#arg} <= 200 )) || die_named SN_OP_RUN_ARG_SHAPE "argument $((i+1)) of '$name' is longer than 200 characters"
        [[ ! "$arg" =~ [[:cntrl:]] ]] || die_named SN_OP_RUN_ARG_SHAPE "argument $((i+1)) of '$name' has a control character"
        re="^(${res[$i]})\$"
        [[ "$arg" =~ $re ]] || die_named SN_OP_RUN_ARG_SHAPE "argument $((i+1)) of '$name' must match ${res[$i]}, got: $arg"
    done

    local -a arr=("$name" "${rest[@]}")
    local args_json; args_json="$(_args_json arr)"; SN_OP_CURRENT_ARGS_JSON="$args_json"
    local -a cmd=("${exe[@]}" "${rest[@]}")
    if [[ "$tier" == "B" ]]; then
        [[ -n "$approval" ]] || die_named SN_OP_APPROVAL_REQUIRED "run $name requires --approval <task_id>"
        verify_approval "$approval" "run:$name" "$args_json"
        run_and_record "run:$name" B "$args_json" "$approval" "${cmd[@]}"
    else
        run_and_record "run:$name" A "$args_json" "" "${cmd[@]}"
    fi
}

# ---------- dispatch ---------------------------------------------------------

main() {
    (( $# > 0 )) || usage
    local verb="$1"; shift
    case "$verb" in
        chgrp)              verb_chgrp              "$@" ;;
        chmod)              verb_chmod              "$@" ;;
        setfacl)            verb_setfacl            "$@" ;;
        groupadd)           verb_groupadd           "$@" ;;
        groupmod-rename)    verb_groupmod_rename    "$@" ;;
        gpasswd-add)        verb_gpasswd_add        "$@" ;;
        gpasswd-del)        verb_gpasswd_del        "$@" ;;
        mkdir)              verb_mkdir              "$@" ;;
        mv)                 verb_mv                 "$@" ;;
        service-start)      verb_service_start      "$@" ;;
        service-restart)    verb_service_restart    "$@" ;;
        service-reload)     verb_service_reload     "$@" ;;
        service-status)     verb_service_status     "$@" ;;
        container-start)    verb_container_start    "$@" ;;
        container-restart)  verb_container_restart  "$@" ;;
        container-status)   verb_container_status   "$@" ;;
        journal-tail)       verb_journal_tail       "$@" ;;
        journal-since)      verb_journal_since      "$@" ;;
        unit-enable)        verb_unit_enable        "$@" ;;
        service-stop)       verb_service_stop       "$@" ;;
        unit-install)       verb_unit_install       "$@" ;;
        container-stop)     verb_container_stop     "$@" ;;
        rm)                 verb_rm                 "$@" ;;
        dropin-install)     verb_dropin_install     "$@" ;;
        route-install)      verb_route_install      "$@" ;;
        ufw-allow-docker)   verb_ufw_allow_docker   "$@" ;;
        run)                verb_run                "$@" ;;
        verbs)              verb_verbs              "$@" ;;
        --help|-h|help)     usage ;;
        --version)          echo "sn-op $SN_OP_VERSION"; exit 0 ;;
        *)                  die_named SN_OP_UNKNOWN_VERB "unknown verb: $verb (see --help)" ;;
    esac
}

main "$@"
