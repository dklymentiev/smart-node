}

verb_mkdir() {
    SN_OP_CURRENT_VERB=mkdir; SN_OP_CURRENT_TIER=A
    local parents=""
    if [[ "${1:-}" == "-p" ]]; then parents="-p"; shift; fi
    (( $# == 1 )) || die_named SN_OP_ARG_COUNT "mkdir takes [-p] <path> (got $# non-flag arg(s))"
    local path="$1"
    validate_path "$path"
    local arr=("$parents" "$path"); [[ -z "$parents" ]] && arr=("$path")
    local args_json; args_json="$(_args_json arr)"; SN_OP_CURRENT_ARGS_JSON="$args_json"
    if [[ -n "$parents" ]]; then
        run_and_record mkdir A "$args_json" "" /bin/mkdir -p -- "$CANONICAL_PATH"
    else
        run_and_record mkdir A "$args_json" "" /bin/mkdir -- "$CANONICAL_PATH"
    fi
}

verb_mv() {
    SN_OP_CURRENT_VERB=mv; SN_OP_CURRENT_TIER=A
    (( $# == 2 )) || die_named SN_OP_ARG_COUNT "mv takes <src-path> <dst-path> (got $#)"
    local src="$1" dst="$2"
    validate_path "$src"; local csrc="$CANONICAL_PATH"
    validate_path "$dst"; local cdst="$CANONICAL_PATH"
    local arr=("$src" "$dst") args_json; args_json="$(_args_json arr)"; SN_OP_CURRENT_ARGS_JSON="$args_json"
    run_and_record mv A "$args_json" "" /bin/mv -- "$csrc" "$cdst"
}

_verb_service() {
    local action="$1"; shift
    SN_OP_CURRENT_VERB="service-$action"; SN_OP_CURRENT_TIER=A
    (( $# == 1 )) || die_named SN_OP_ARG_COUNT "service-$action takes <unit> (got $#)"
    local unit="$1"
    validate_unit "$unit"
    local arr=("$unit") args_json; args_json="$(_args_json arr)"; SN_OP_CURRENT_ARGS_JSON="$args_json"
    run_and_record "service-$action" A "$args_json" "" /bin/systemctl "$action" -- "$unit"
}

verb_service_start()   { _verb_service start   "$@"; }
verb_service_restart() { _verb_service restart "$@"; }
verb_service_reload()  { _verb_service reload  "$@"; }
verb_service_status()  { _verb_service status  "$@"; }

